# Шаблон реестра моделей и провайдеров
# Замените <YOUR_API_KEY> на ваш реальный ключ
providers:
  openai-compatible:
    baseUrl: https://api.openai.com/v1
    api: openai-completions
    apiKey: "<YOUR_API_KEY>"
    authHeader: true
    discovery:
      type: openai-models-list
    models:
      - id: gpt-4o
        name: GPT-4o
        contextWindow: 128000
        maxTokens: 16384
      - id: gpt-4o-mini
        name: GPT-4o Mini (Scout)
        contextWindow: 128000
        maxTokens: 16384

  openrouter:
    baseUrl: https://openrouter.ai/api/v1
    api: openai-completions
    apiKey: "<YOUR_API_KEY>"
    authHeader: true
    models:
      - id: google/gemini-2.5-flash
        name: Gemini 2.5 Flash
        contextWindow: 1000000
        maxTokens: 16384
      - id: deepseek/deepseek-chat
        name: DeepSeek V3
        contextWindow: 128000
        maxTokens: 8192
